# Contentstack credentials (used by Playwright e2e tests only)
EMAIL=
PASSWORD=

# Organization ID
ORG_ID=

# Stack API Key
STACK_API_KEY=

# Base URL where the app is hosted/running locally
APP_BASE_URL=http://localhost:4000

# Basic auth credentials (optional — only if your host requires it)
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=

# Contentstack platform endpoints (leave as-is for production)
DEVELOPER_HUB_API=developerhub-api.contentstack.com
ENV_URL=https://app.contentstack.com/
BASE_API_URL=api.contentstack.io

# Required for the app to run — your Contentstack app host URL
VITE_PUBLIC_KEY_BASE_URL=https://app.contentstack.com